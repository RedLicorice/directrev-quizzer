# Copy to terraform.tfvars (git-ignored) and fill in.
account_id            = "123456789012"
region                = "us-east-1"
cognito_domain_prefix = "quizzer-x7k2"
admin_email           = "you@example.com"
budget_amount_usd     = 5
# github_owner        = "RedLicorice"
# dataset_ids         = ["aws-dva-c02", "mule-mcd-01"]
# create_github_oidc_provider = false   # if the account already has token.actions.githubusercontent.com

# Custom domain (lower case host name; DNS on Cloudflare, not Route 53). It gets an ACM
# certificate (DNS validation) and a CloudFront alias, and becomes the only accepted app
# host. Leave it commented to keep the *.cloudfront.net domain.
# custom_domain = "quizzer.example.com"
# Keep the *.cloudfront.net domain working next to the custom domain (second accepted host).
# also_serve_cloudfront_domain = true

# Only if a dataset repo has GitHub's "immutable subject claims" enabled (default for new
# repos: check with `gh api repos/<owner>/<repo>/actions/oidc/customization/sub`). Otherwise
# the OIDC trust condition in modules/ci defaults to the classic sub and this is not needed.
# dataset_oidc_subjects = {
#   "aws-dva-c02" = ["repo:RedLicorice@<ownerId>/quizzer-dataset-aws-dva-c02@<repoId>:environment:prod"]
# }

# Invite links (all optional; these are the defaults).
# invite_links = {
#   default_ttl_hours   = 168   # validity offered by default in the admin UI
#   max_ttl_hours       = 720
#   default_max_uses    = 1
#   max_max_uses        = 50
#   retention_days      = 30    # expired/revoked links stay in the table (and the admin list) this long
#   join_attempts       = 10    # per IP and window on POST /auth/join
#   join_window_seconds = 600
# }
