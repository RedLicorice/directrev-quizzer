# Copy to terraform.tfvars (git-ignored) and fill in.
account_id            = "123456789012"
region                = "us-east-1"
cognito_domain_prefix = "quizzer-x7k2"
admin_email           = "you@example.com"
budget_amount_usd     = 5
# github_owner        = "RedLicorice"
# dataset_ids         = ["aws-dva-c02", "mule-mcd-01"]
# create_github_oidc_provider = false   # if the account already has token.actions.githubusercontent.com

# Only if a dataset repo has GitHub's "immutable subject claims" enabled (default for new
# repos: check with `gh api repos/<owner>/<repo>/actions/oidc/customization/sub`). Otherwise
# the OIDC trust condition in modules/ci defaults to the classic sub and this is not needed.
